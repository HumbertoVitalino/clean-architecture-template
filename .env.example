# Application
ASPNETCORE_ENVIRONMENT=Production
API_PORT=8080

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YourStrong@Passw0rd
POSTGRES_DB=companyname_projectname

# Connection String (uses service name 'postgres' as host inside docker-compose)
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=companyname_projectname;Username=postgres;Password=YourStrong@Passw0rd

# JWT
Jwt__SecretKey=your-secret-key-with-at-least-32-characters!!
Jwt__Issuer=your-issuer
Jwt__Audience=your-audience
Jwt__ExpirationInMinutes=60
